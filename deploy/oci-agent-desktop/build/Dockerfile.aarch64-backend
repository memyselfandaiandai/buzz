# syntax=docker/dockerfile:1.7
FROM --platform=linux/arm64 rust:1.95-bookworm@sha256:6258907abe69656e41cd992e0b705cdcfabcbbe3db374f92ed2d47121282d4a1 AS builder
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends build-essential cmake file perl pkg-config protobuf-compiler \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add aarch64-unknown-linux-gnu
WORKDIR /build
COPY . .
RUN cargo build --locked --release -p buzz-backend-kubernetes --target aarch64-unknown-linux-gnu \
    && file target/aarch64-unknown-linux-gnu/release/buzz-backend-kubernetes | grep -q 'ARM aarch64' \
    && printf '{"op":"info"}\n' | target/aarch64-unknown-linux-gnu/release/buzz-backend-kubernetes | grep -q '"ok":true'

FROM scratch AS export
COPY --from=builder /build/target/aarch64-unknown-linux-gnu/release/buzz-backend-kubernetes /
