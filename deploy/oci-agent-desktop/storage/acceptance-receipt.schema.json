{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buzz.local/schemas/acceptance-receipt-v1.json",
  "title": "FINAL-FORM artifact acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "issuer", "receipt_id", "task_id", "session_id", "agent_id", "workspace_id", "manifest_sha256", "transfer_receipt_sha256s", "decision", "decided_at"],
  "properties": {
    "version": {"const": 1},
    "issuer": {"const": "final-form"},
    "receipt_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "format": "uuid"},
    "session_id": {"type": "string", "format": "uuid"},
    "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "workspace_id": {"type": "string", "format": "uuid"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "transfer_receipt_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "decision": {"enum": ["accepted", "rejected"]},
    "decided_at": {"type": "string", "format": "date-time"},
    "accepted_checkpoint_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "message": {"type": "string", "maxLength": 4096}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "accepted"}}},
      "then": {"required": ["accepted_checkpoint_id"]}
    }
  ]
}
